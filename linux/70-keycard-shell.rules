# Keycard Shell (USB 1209:21f7): let the logged-in user open its HID device.
# Install: sudo cp 70-keycard-shell.rules /etc/udev/rules.d/ && sudo udevadm control --reload-rules, then re-plug the Shell.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="21f7", MODE="0660", TAG+="uaccess"
